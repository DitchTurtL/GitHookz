@page "/my-projects"
@using GitHookz.Data
@using GitHookz.Services
@inject IDatabaseService DatabaseService
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage

<MudText Typo="Typo.h4" Class="mb-6">My Projects</MudText>

@if (Projects.Count() > 0) 
{
    <MudPaper>
        <MudDataGrid Items="@Projects" Filterable="false" SortMode="@SortMode.None" Groupable="false">
            <Columns>
                <PropertyColumn Property="x => x.RepositoryName" Title="Repository" />
                <PropertyColumn Property="x => x.ChannelName" Title="Channel" />
                <PropertyColumn Property="x => x.CreatedAt" Title="Created" />
                <PropertyColumn Property="x => x.LastUpdatedAt" Title="Updated" />
            </Columns>
        </MudDataGrid>
    </MudPaper>
}


@code {
    private IEnumerable<ProjectData> Projects { get; set; } = [];

    private string? DiscordId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userId = await SessionStorage.GetItemAsync<int>("userId");
            if (userId > 0)
            {
                var user = DatabaseService.GetUserById(userId);
                if (user != null) 
                {
                    DiscordId = user.DiscordId;
                    Projects = DatabaseService.GetProjectsByOwnerId(DiscordId);
                }
            }
            StateHasChanged();
        }

        await base.OnAfterRenderAsync(firstRender);
    }
}
