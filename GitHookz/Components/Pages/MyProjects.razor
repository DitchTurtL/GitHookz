@page "/my-projects"
@using GitHookz.Data
@using GitHookz.Services
@inject IDatabaseService DatabaseService
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage

<MudText Typo="Typo.h4" Class="mb-6">My Projects</MudText>

@if (Projects.Count() > 0) 
{
    <MudPaper>

        <MudExpansionPanels>
            @foreach (var project in Projects)
            {
                <MudExpansionPanel Text="@project.RepositoryName">
                    <MudText>Details:</MudText>
                    <MudText>Channel: @project.ChannelName</MudText>
                    <MudText>Created: @project.CreatedAt</MudText>
                    <MudText>Updated: @project.LastUpdatedAt</MudText>


                    <MudText Class="mt-6">Webhooks:</MudText>
                    <MudStack Wrap="Wrap.Wrap" Row="true" AlignItems="AlignItems.Center">
                        <MudSwitch @bind-Value="project.CanSendPing" Label="Ping" Color="Color.Primary" />
                        <MudSwitch @bind-Value="project.CanSendIssue" Label="Issue" Color="Color.Primary" />
                        <MudSwitch @bind-Value="project.CanSendIssueComment" Label="Issue Comment" Color="Color.Primary" />
                        <MudSwitch @bind-Value="project.CanSendPull" Label="Pull" Color="Color.Primary" />
                        <MudSwitch @bind-Value="project.CanSendPullRequest" Label="Pull Request" Color="Color.Primary" />
                        <MudSwitch @bind-Value="project.CanSendPullRequestReview" Label="Pull Request Review" Color="Color.Primary" />
                        <MudSwitch @bind-Value="project.CanSendPush" Label="Push" Color="Color.Primary" />
                        <MudSwitch @bind-Value="project.CanSendFork" Label="Fork" Color="Color.Primary" />
                        <MudSwitch @bind-Value="project.CanSendStar" Label="Star" Color="Color.Primary" />
                        <MudSwitch @bind-Value="project.CanSendWatch" Label="Watch" Color="Color.Primary" />
                        <MudSwitch @bind-Value="project.CanSendRelease" Label="Release" Color="Color.Primary" />
                    </MudStack>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => UpdateProject(project))">
                        Update
                    </MudButton>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudPaper>
}


@code {
    private IEnumerable<ProjectData> Projects { get; set; } = [];

    private string? DiscordId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userId = await SessionStorage.GetItemAsync<int>("userId");
            if (userId > 0)
            {
                var user = DatabaseService.GetUserById(userId);
                if (user != null) 
                {
                    DiscordId = user.DiscordId;
                    Projects = DatabaseService.GetProjectsByOwnerId(DiscordId);
                }
            }
            StateHasChanged();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private Task UpdateProject(ProjectData project)
    {
        // Here you can send the updated project data to an API
        DatabaseService.UpdateProject(project);

        return Task.CompletedTask;
    }
}
